# Terraform and provider constraints for the production main stack (Task 15+).

terraform {
  required_version = ">= 1.5.0"

  required_providers {
    azurerm = {
      source  = "hashicorp/azurerm"
      version = "~> 4.0"
    }
  }

  backend "azurerm" {}
}

provider "azurerm" {
  storage_use_azuread = true

  features {}
}
